// =======================================================
// SCRIPT 3 — BASELINE: Degradación persistente ≥3 años (y,y+1,y+2)
// Evento anual = dBSI>thr AND (dNDVI<thr OR dNBR<thr)
// Dentro de bosque MB (MMU≥1ha)
// Output: CSV 2014–2022 con áreas degradadas total + por estrato AGB
// =======================================================

var OUT_FOLDER = 'kaaguy_baseline';
var AOI_ASSET = 'projects/bosques-nativos-gbaapa/assets/PRELIMINARYKAAGUY';

var aoi = ee.FeatureCollection(AOI_ASSET).geometry().dissolve();
Map.centerObject(aoi, 7);

// Umbrales (calibrables)
var BSI_THR   = 0.10;
var NDVI_THR  = -0.06;
var NBR_THR   = -0.06;

// Período (último año reportable será END_YEAR-2)
var START_YEAR = 2014;
var END_YEAR   = 2024;

// MapBiomas
var mb = ee.Image('projects/mapbiomas-public/assets/paraguay/collection1/mapbiomas_paraguay_collection1_integration_v1');
var pxArea = ee.Image.pixelArea();

// FIX MapBiomas year ".0"
function bosqueMB_MMU(year) {
  year = ee.Number(year).toInt();
  var band = ee.String('classification_').cat(year.format('%d'));
  var bandSafe = ee.String(ee.Algorithms.If(year.lte(2022), band, 'classification_2022'));
  var b3 = mb.select(bandSafe).eq(3);
  var mmu = b3.connectedPixelCount(12, true).gte(12);
  return b3.and(mmu).selfMask().clip(aoi);
}

// --- Estratos AGB (mismos del Script 2) ---
var bosque30 = bosqueMB_MMU(2022);
var bosqueFrac300 = bosque30.reduceNeighborhood({
  reducer: ee.Reducer.mean(),
  kernel: ee.Kernel.square({radius:150, units:'meters'})
});
var FRAC_THRESHOLD = 0.4;
var bosqueMask300 = bosqueFrac300.gt(FRAC_THRESHOLD).selfMask();

var agb = ee.ImageCollection('NASA/ORNL/biomass_carbon_density/v1')
  .select('agb').first().clip(aoi);

var agbForest = agb.updateMask(bosqueMask300);

var perc = agbForest.reduceRegion({
  reducer: ee.Reducer.percentile([33,66]),
  geometry: aoi,
  scale: 300,
  maxPixels: 1e13
});

var p33 = ee.Number(perc.get('agb_p33'));
var p66 = ee.Number(perc.get('agb_p66'));

var estratos = ee.Image(0)
  .where(agbForest.gt(p66), 1)
  .where(agbForest.gte(p33).and(agbForest.lte(p66)), 2)
  .where(agbForest.lt(p33), 3)
  .updateMask(bosqueMask300)
  .rename('estrato');

// --- fechas seguras ---
function yearStart(y){ return ee.Date.fromYMD(ee.Number(y).toInt(), 1, 1); }
function yearEnd(y){ return yearStart(y).advance(1, 'year'); }

// Sentinel-2 composite
function s2Comp(year) {
  year = ee.Number(year).toInt();
  var col = ee.ImageCollection('COPERNICUS/S2_SR')
    .filterBounds(aoi)
    .filterDate(yearStart(year), yearEnd(year))
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
    .select(['B4','B8','B11','B12'], ['R','N','S1','S2']);
  return ee.Image(ee.Algorithms.If(col.size().gt(0), col.median().clip(aoi), ee.Image([])));
}

// Landsat 8/9 composite
function lsComp(year) {
  year = ee.Number(year).toInt();
  var c8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterBounds(aoi).filterDate(yearStart(year), yearEnd(year))
    .filter(ee.Filter.lt('CLOUD_COVER',20));
  var c9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2')
    .filterBounds(aoi).filterDate(yearStart(year), yearEnd(year))
    .filter(ee.Filter.lt('CLOUD_COVER',20));
  var col = c8.merge(c9).map(function(img){ return img.multiply(0.0000275).add(-0.2); });
  return ee.Image(ee.Algorithms.If(col.size().gt(0),
    col.median().select(['SR_B4','SR_B5','SR_B7'], ['R','N','S2']).clip(aoi),
    ee.Image([])));
}

// dBSI / dNBR / dNDVI
function dBSI_S2(c,p){ return c.normalizedDifference(['S1','N']).subtract(p.normalizedDifference(['S1','N'])).rename('dBSI'); }
function dNBR_S2(c,p){ return c.normalizedDifference(['N','S2']).subtract(p.normalizedDifference(['N','S2'])).rename('dNBR'); }
function dNDVI_LS(c,p){ return c.normalizedDifference(['N','R']).subtract(p.normalizedDifference(['N','R'])).rename('dNDVI'); }

// candidato anual robusto
function degCandidate(year) {
  year = ee.Number(year).toInt();

  var bosque = bosqueMB_MMU(year);
  var bosquePrev = bosqueMB_MMU(year.subtract(1));

  var s2C = s2Comp(year), s2P = s2Comp(year.subtract(1));
  var lsC = lsComp(year), lsP = lsComp(year.subtract(1));

  var hasS2 = s2C.bandNames().size().gt(0).and(s2P.bandNames().size().gt(0));
  var hasLS = lsC.bandNames().size().gt(0).and(lsP.bandNames().size().gt(0));

  var dBSI = ee.Image(ee.Algorithms.If(hasS2, dBSI_S2(s2C,s2P), ee.Image.constant(0).rename('dBSI'))).updateMask(bosque);
  var dNBR = ee.Image(ee.Algorithms.If(hasS2, dNBR_S2(s2C,s2P), ee.Image.constant(0).rename('dNBR'))).updateMask(bosque);
  var dNDV = ee.Image(ee.Algorithms.If(hasLS, dNDVI_LS(lsC,lsP), ee.Image.constant(0).rename('dNDVI'))).updateMask(bosque);

  return dBSI.gt(BSI_THR)
    .and(dNDV.lt(NDVI_THR).or(dNBR.lt(NBR_THR)))
    .and(bosquePrev.mask().unmask(0).eq(1))
    .selfMask()
    .rename('deg');
}

// persistencia 3 años
function degPersistent(year) {
  year = ee.Number(year).toInt();
  var d0 = degCandidate(year);
  var d1 = degCandidate(year.add(1));
  var d2 = degCandidate(year.add(2));
  return d0.and(d1).and(d2).selfMask().rename('deg_persist');
}

// área ha
function areaHa(img, scale) {
  var m2 = ee.Number(img.multiply(pxArea).reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: aoi,
    scale: scale,
    maxPixels: 1e13
  }).values().get(0));
  return m2.divide(10000);
}

function areaHaByStratum(img, code) {
  return areaHa(img.updateMask(estratos.eq(code)), 30);
}

// años reportables
var years = ee.List.sequence(START_YEAR, END_YEAR - 2);

var tabla = ee.FeatureCollection(years.map(function(y){
  y = ee.Number(y).toInt();

  var bosque = bosqueMB_MMU(y);
  var bosque_ha = areaHa(bosque, 30);

  var degP = degPersistent(y);

  return ee.Feature(null, {
    anio: y,
    bosque_ha: bosque_ha,
    deg_persist_total_ha: areaHa(degP, 30),
    deg_persist_alto_ha: areaHaByStratum(degP, 1),
    deg_persist_medio_ha: areaHaByStratum(degP, 2),
    deg_persist_bajo_ha: areaHaByStratum(degP, 3),
    BSI_THR: BSI_THR,
    NDVI_THR: NDVI_THR,
    NBR_THR: NBR_THR,
    FRAC_THRESHOLD: FRAC_THRESHOLD
  });
}));

print('Baseline Excel-ready', tabla);

Export.table.toDrive({
  collection: tabla,
  description: 'KAAGUY_Baseline_DegPersist3y_ByStratum_' + START_YEAR + '_' + (END_YEAR-2),
  folder: OUT_FOLDER,
  fileFormat: 'CSV'
});

Map.addLayer(degPersistent(START_YEAR), {palette:['ff0000']}, 'Deg persistente 3y (inicio)');
