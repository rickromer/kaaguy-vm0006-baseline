/**** KA'AGUY+ | 3 estratos | 1 año por script | SIN RF
 * Cambiar solo:
 *   var focalYear = 2005;
 *
 * Usa:
 *   P33 = 26
 *   P66 = 53
 *
 * Lógica:
 * - ancla 2010 con AGB
 * - score espectral anual con NDVI/NBR/NDMI
 * - 3 estratos por score
 * - transición persistente 3 años
 */

var AOI_ASSET = 'projects/bosques-nativos-gbaapa/assets/PRELIMINARYKAAGUY';
var aoi = ee.FeatureCollection(AOI_ASSET).geometry();

var mb = ee.Image('projects/mapbiomas-public/assets/paraguay/collection1/mapbiomas_paraguay_collection1_integration_v1');

// =========================
// CAMBIAR SOLO ESTO
// =========================
var focalYear = 2020;

// =========================
// PARÁMETROS
// =========================
var forestClass = 3;
var dryStartMonth = 6;
var dryEndMonth = 9;
var maxCloud = 20;

var areaScale = 60;   // más liviano
var statsScale = 120; // para medias del ancla
var exportFolder = 'KAAGUY_VM0006';

var p33 = 26;
var p66 = 53;

var haImg = ee.Image.pixelArea().divide(10000).rename('ha');

// =========================
// FUNCIONES
// =========================
function mbForest(year) {
  year = ee.Number(year).int();
  var bandName = ee.String('classification_').cat(year.format());
  return mb.select(bandName).eq(forestClass).rename('forest');
}

function prepL57(img) {
  var qa = img.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1 << 1).eq(0)
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(img.select('QA_RADSAT').eq(0));

  var scaled = img.select(['SR_B1','SR_B2','SR_B3','SR_B4','SR_B5','SR_B7'])
    .multiply(0.0000275).add(-0.2)
    .rename(['blue', 'green', 'red', 'nir', 'swir1', 'swir2']);

  return scaled.updateMask(mask).copyProperties(img, ['system:time_start']);
}

function prepL89(img) {
  var qa = img.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1 << 1).eq(0)
    .and(qa.bitwiseAnd(1 << 2).eq(0))
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0))
    .and(img.select('QA_RADSAT').eq(0));

  var scaled = img.select(['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7'])
    .multiply(0.0000275).add(-0.2)
    .rename(['blue', 'green', 'red', 'nir', 'swir1', 'swir2']);

  return scaled.updateMask(mask).copyProperties(img, ['system:time_start']);
}

function getLandsatCollection(year) {
  year = ee.Number(year).int();
  var start = ee.Date.fromYMD(year, dryStartMonth, 1);
  var end = ee.Date.fromYMD(year, dryEndMonth, 30);

  var l5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
    .filterBounds(aoi)
    .filterDate(start, end.advance(1, 'day'))
    .filter(ee.Filter.lte('CLOUD_COVER', maxCloud))
    .map(prepL57);

  var l7 = ee.ImageCollection('LANDSAT/LE07/C02/T1_L2')
    .filterBounds(aoi)
    .filterDate(start, end.advance(1, 'day'))
    .filter(ee.Filter.lte('CLOUD_COVER', maxCloud))
    .map(prepL57);

  var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterBounds(aoi)
    .filterDate(start, end.advance(1, 'day'))
    .filter(ee.Filter.lte('CLOUD_COVER', maxCloud))
    .map(prepL89);

  var l9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2')
    .filterBounds(aoi)
    .filterDate(start, end.advance(1, 'day'))
    .filter(ee.Filter.lte('CLOUD_COVER', maxCloud))
    .map(prepL89);

  return l5.merge(l7).merge(l8).merge(l9);
}

function addIndices(img) {
  var ndvi = img.normalizedDifference(['nir', 'red']).rename('NDVI');
  var nbr = img.normalizedDifference(['nir', 'swir2']).rename('NBR');
  var ndmi = img.normalizedDifference(['nir', 'swir1']).rename('NDMI');
  return img.addBands([ndvi, nbr, ndmi]);
}

function annualPredictors(year) {
  year = ee.Number(year).int();
  var col = getLandsatCollection(year);
  var nScenes = col.size();

  var pred = ee.Image(ee.Algorithms.If(
    nScenes.gt(0),
    addIndices(col.median()).select(['NDVI', 'NBR', 'NDMI']),
    ee.Image.constant([0, 0, 0]).rename(['NDVI', 'NBR', 'NDMI']).updateMask(ee.Image(0))
  ));

  return pred.set('year', year).set('n_scenes', nScenes);
}

function areaHa(mask) {
  var val = haImg.updateMask(mask).reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: aoi,
    scale: areaScale,
    maxPixels: 1e13,
    tileScale: 16,
    bestEffort: true
  }).get('ha');

  return ee.Number(ee.Algorithms.If(val, val, 0));
}

function meanBand(img, mask, bandName) {
  var val = img.select(bandName).updateMask(mask).reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: aoi,
    scale: statsScale,
    maxPixels: 1e13,
    tileScale: 16,
    bestEffort: true
  }).get(bandName);

  return ee.Number(ee.Algorithms.If(val, val, 0));
}

// =========================
// ANCLA AGB 2010
// =========================
var agbc2010 = ee.ImageCollection('NASA/ORNL/biomass_carbon_density/v1')
  .first()
  .select('agb')
  .rename('agbc_2010');

var stable2010Forest = mbForest(2009)
  .and(mbForest(2010))
  .and(mbForest(2011))
  .and(mbForest(2012))
  .selfMask();

var lowMask = agbc2010.updateMask(stable2010Forest).lt(p33);
var midMask = agbc2010.updateMask(stable2010Forest).gte(p33).and(agbc2010.updateMask(stable2010Forest).lte(p66));
var highMask = agbc2010.updateMask(stable2010Forest).gt(p66);

// Predictores 2010
var pred2010 = annualPredictors(2010).updateMask(stable2010Forest);

// Medias espectrales por estrato ancla
var lowNDVI  = meanBand(pred2010, lowMask,  'NDVI');
var lowNBR   = meanBand(pred2010, lowMask,  'NBR');
var lowNDMI  = meanBand(pred2010, lowMask,  'NDMI');

var highNDVI = meanBand(pred2010, highMask, 'NDVI');
var highNBR  = meanBand(pred2010, highMask, 'NBR');
var highNDMI = meanBand(pred2010, highMask, 'NDMI');

// =========================
// ESTRATO ANUAL POR SCORE
// =========================
function annualStratum(year) {
  year = ee.Number(year).int();
  var pred = annualPredictors(year);
  var forest = mbForest(year);

  var sNDVI = pred.select('NDVI').subtract(lowNDVI).divide(highNDVI.subtract(lowNDVI));
  var sNBR  = pred.select('NBR').subtract(lowNBR).divide(highNBR.subtract(lowNBR));
  var sNDMI = pred.select('NDMI').subtract(lowNDMI).divide(highNDMI.subtract(lowNDMI));

  var score = sNDVI.add(sNBR).add(sNDMI).divide(3).rename('score');

  // limitar score
  score = score.where(score.lt(0), 0);
  score = score.where(score.gt(1), 1);

  var stratum = ee.Image(0)
    .where(score.lt(0.333333), 1)
    .where(score.gte(0.333333).and(score.lte(0.666667)), 2)
    .where(score.gt(0.666667), 3)
    .updateMask(forest)
    .rename('stratum')
    .set('year', year)
    .set('n_scenes', pred.get('n_scenes'));

  return stratum;
}

// =========================
// SOLO 4 AÑOS NECESARIOS
// =========================
var prev = annualStratum(focalYear - 1);
var cur  = annualStratum(focalYear);
var p1   = annualStratum(focalYear + 1);
var p2   = annualStratum(focalYear + 2);

// Bosque elegible estable 4 años
var forest4 = mbForest(focalYear - 1)
  .and(mbForest(focalYear))
  .and(mbForest(focalYear + 1))
  .and(mbForest(focalYear + 2))
  .selfMask();

prev = prev.updateMask(forest4);
cur  = cur.updateMask(forest4);
p1   = p1.updateMask(forest4);
p2   = p2.updateMask(forest4);

// =========================
// TRANSICIONES PERSISTENTES
// =========================
var h2m = prev.eq(3).and(cur.eq(2)).and(p1.eq(2)).and(p2.eq(2)).selfMask();
var h2l = prev.eq(3).and(cur.eq(1)).and(p1.eq(1)).and(p2.eq(1)).selfMask();
var m2l = prev.eq(2).and(cur.eq(1)).and(p1.eq(1)).and(p2.eq(1)).selfMask();

var bosqueElegibleHa = areaHa(forest4);
var h2mHa = areaHa(h2m);
var h2lHa = areaHa(h2l);
var m2lHa = areaHa(m2l);
var totalDegHa = h2mHa.add(h2lHa).add(m2lHa);

var tasa = ee.Number(ee.Algorithms.If(
  bosqueElegibleHa.gt(0),
  totalDegHa.divide(bosqueElegibleHa).multiply(100),
  0
));

// =========================
// EXPORTAR 1 FILA
// =========================
var out = ee.FeatureCollection([
  ee.Feature(null, {
    anio: focalYear,
    anio_prev: focalYear - 1,
    anio_p1: focalYear + 1,
    anio_p2: focalYear + 2,

    p33_anchor_2010: p33,
    p66_anchor_2010: p66,

    bosque_elegible_ha: bosqueElegibleHa,
    h2m_ha: h2mHa,
    h2l_ha: h2lHa,
    m2l_ha: m2lHa,
    degradacion_total_ha: totalDegHa,
    tasa_deg_pct: tasa,

    n_scenes_prev: prev.get('n_scenes'),
    n_scenes_y: cur.get('n_scenes'),
    n_scenes_p1: p1.get('n_scenes'),
    n_scenes_p2: p2.get('n_scenes')
  })
]);

Export.table.toDrive({
  collection: out,
  description: 'KAAGUY_VM0006_3STRATA_NORF_' + focalYear,
  folder: exportFolder,
  fileFormat: 'CSV'
});
